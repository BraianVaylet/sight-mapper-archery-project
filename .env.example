# Copy to .env (api) / .env.local (pwa). Never commit real values. See docs/TECNICO.md §2.

# --- api ---
NODE_ENV=development
APP_ENV=local
PORT=3000
MONGODB_URI=
# 32+ random bytes. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Without these two (APP_ENV=local only) verification and reset links are written to the log instead of emailed.
RESEND_API_KEY=
EMAIL_FROM=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- pwa ---
VITE_API_URL=http://localhost:3000
VITE_APP_VERSION=
