# The PWA in production (TECNICO §12): static files, the SPA fallback and the security headers.
# API_ORIGIN is the API's public origin (https://api.<domain>), set as a Railway variable; PORT is
# set by Railway.
{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# The hash is the theme script inlined in index.html; scripts/csp.test.mjs fails if they drift.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-uAHLN+daKNsbBZwchz/YFQYYmiWvx2bYNtwCFuUpHKQ='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$API_ORIGIN}; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Hashed file names never change content: cache them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# What tells the app a new version exists is always asked again.
	@entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @entry Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
