# The PWA in production (TECNICO §12): static files, the SPA fallback and the security headers.
# API_UPSTREAM is the API over Railway's private network (api.railway.internal:3000): /api/* goes
# there, so PWA and API share one origin and the session cookie stays first-party (ADR-007).
# API_ORIGIN is only needed if the PWA ever calls the API on another origin. PORT is set by Railway.
{
	admin off
	servers {
		# Railway's edge reaches us from a private address: keep the archer's IP in
		# X-Forwarded-For, the API's rate limits are per IP.
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:localhost:3000}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# The hash is the theme script inlined in index.html; scripts/csp.test.mjs fails if they drift.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-uAHLN+daKNsbBZwchz/YFQYYmiWvx2bYNtwCFuUpHKQ='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$API_ORIGIN}; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}

	# Hashed file names never change content: cache them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# What tells the app a new version exists is always asked again.
	@entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
	header @entry Cache-Control "no-cache"

	# In its own handle: try_files runs before handle in Caddy's order and would turn /api/* into
	# /index.html.
	handle {
		try_files {path} /index.html
		file_server
	}
}
