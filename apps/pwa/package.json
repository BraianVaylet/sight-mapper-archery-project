{
  "name": "@sight-mapper/pwa",
  "version": "0.0.0",
  "private": true,
  "description": "React 19 PWA",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "dependencies": {
    "@sight-mapper/domain": "workspace:*",
    "@sight-mapper/schemas": "workspace:*",
    "@sight-mapper/types": "workspace:*",
    "@sight-mapper/i18n": "workspace:*",
    "@sight-mapper/ui": "workspace:*",
    "@sight-mapper/client": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-form": "catalog:",
    "zustand": "catalog:",
    "zod": "catalog:",
    "workbox-window": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "@sight-mapper/config": "workspace:*",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "workbox-build": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@testing-library/jest-dom": "catalog:"
  }
}
